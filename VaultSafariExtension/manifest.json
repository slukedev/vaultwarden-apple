{
    "manifest_version": 3,
    "name": "Vaultwarden",
    "description": "Helps Safari AutoFill find login and verification code fields, and saves new passwords on Mac.",
    "version": "1.1.0",
    "icons": {
        "48": "icon-48.png",
        "96": "icon-96.png",
        "128": "icon-128.png",
        "256": "icon-256.png",
        "512": "icon-512.png"
    },
    "background": {
        "scripts": ["background.js"],
        "persistent": false
    },
    "content_scripts": [
        {
            "js": ["content.js"],
            "matches": ["https://*/*", "http://*/*"],
            "all_frames": true,
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon-16.png",
            "19": "icon-19.png",
            "32": "icon-32.png",
            "38": "icon-38.png",
            "48": "icon-48.png"
        }
    },
    "permissions": ["nativeMessaging", "activeTab"]
}
